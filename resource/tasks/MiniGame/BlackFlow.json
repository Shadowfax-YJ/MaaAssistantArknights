        "action": "ClickSelf",
        "template": [
            "Roguelike@StageTraderRefreshWithDiceConfirm.png",
            "Roguelike@StageTraderRefreshConfirmNew.png",
            "Roguelike@StageTraderRefreshConfirm.png"
        ],
        "roi": [580, 375, 700, 230],
        "maxTimes": 1,
        "postDelay": 500
    },
    "MiniGame@BlackFlow@DismissRefreshDialog": {
        "Doc": "Best-effort store-internal refresh-dialog cleanup command.",
        "algorithm": "MatchTemplate",
        "action": "ClickRect",
        "template": [
            "Roguelike@StageTraderRefreshWithDiceConfirm.png",
            "Roguelike@StageTraderRefreshConfirmNew.png",
            "Roguelike@StageTraderRefreshConfirm.png"
        ],
        "roi": [580, 375, 700, 230],
        "specificRect": [600, 610, 1, 1],
        "maxTimes": 1,
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@StorePageReady"]
    }
}
