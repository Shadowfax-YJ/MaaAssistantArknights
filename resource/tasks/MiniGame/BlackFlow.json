        "template": "Roguelike@StageTraderRefresh.png",
        "roi": [230, 47, 211, 182],
        "maxTimes": 1,
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@RefreshDialogVisible"]
    },
    "MiniGame@BlackFlow@RefreshDialogVisible": {
        "algorithm": "MatchTemplate",
        "action": "DoNothing",
        "template": [
            "Roguelike@StageTraderRefreshWithDiceConfirm.png",
            "Roguelike@StageTraderRefreshConfirmNew.png",
            "Roguelike@StageTraderRefreshConfirm.png"
        ],
        "roi": [580, 375, 700, 230]
    },
    "MiniGame@BlackFlow@ConfirmRefresh": {
