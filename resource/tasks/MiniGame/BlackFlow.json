{
    "MiniGame@BlackFlow@Begin": {
        "doc": "黑流树海开拓者分队数据收集入口；可从开始探索、第一层地图或探索总览恢复",
        "algorithm": "JustReturn",
        "next": [
            "MiniGame@BlackFlow@StartExplore",
            "MiniGame@BlackFlow@ExitExploration",
            "MiniGame@BlackFlow@Abandon"
        ]
    },
    "MiniGame@BlackFlow@StartExplore": {
        "doc": "点击开始探索，并重置本周期结束等待次数",
        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["开始探索"],
        "roi": [1000, 560, 200, 100],
        "reduceOtherTimes": [
            "MiniGame@BlackFlow@WaitForExploreRestart*20",
            "MiniGame@BlackFlow@SwipeToPioneerSquad*20",
            "MiniGame@BlackFlow@WaitForFirstLayer*20"
        ],
        "next": [
            "MiniGame@BlackFlow@ChoosePioneerSquad",
            "MiniGame@BlackFlow@SwipeToPioneerSquad",
            "#self"
        ]
    },
    "MiniGame@BlackFlow@ChoosePioneerSquad": {
        "doc": "选择开拓者分队；加工品弹窗出现前重复检查本界面",
        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["开拓者分队"],
        "roi": [0, 320, 1280, 190],
        "next": [
            "MiniGame@BlackFlow@ConfirmPioneerSquad",
            "MiniGame@BlackFlow@ProcessingItemReady",
            "#self"
        ]
    },
    "MiniGame@BlackFlow@ConfirmPioneerSquad": {
        "doc": "复用首页自动肉鸽的分队确认逻辑，用黑流树海专用模板定位并点击卡片内对勾",
        "baseTask": "JieGarden@Roguelike@SquadConfirm",
        "template": "MiniGame@BlackFlow@PioneerSquadConfirm.png",
        "next": [
            "MiniGame@BlackFlow@ProcessingItemReady",
            "MiniGame@BlackFlow@ChoosePioneerSquad",
            "#self"
        ]
    },
    "MiniGame@BlackFlow@SwipeToPioneerSquad": {
        "doc": "复用通用横向滑动，直到开拓者分队进入可见区域",
        "baseTask": "SwipeToTheRight",
        "postDelay": 500,
        "maxTimes": 20,
        "exceededNext": ["Stop"],
        "next": ["MiniGame@BlackFlow@ChoosePioneerSquad", "#self"]
    },
    "MiniGame@BlackFlow@ProcessingItemReady": {
        "doc": "只识别加工品弹窗；BlackFlowDataCollectionTaskPlugin 在此保存完整截图",
        "algorithm": "OcrDetect",
        "action": "DoNothing",
        "text": ["加工品"],
        "roi": [400, 180, 220, 100],
        "preDelay": 1000,
        "next": ["MiniGame@BlackFlow@CloseProcessingItem"]
    },
    "MiniGame@BlackFlow@CloseProcessingItem": {
        "doc": "点击已确认存在的加工品弹窗关闭按钮",
        "algorithm": "JustReturn",
        "action": "ClickRect",
        "specificRect": [640, 550, 1, 1],
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@ChooseRecruitCombination"]
    },
    "MiniGame@BlackFlow@ChooseRecruitCombination": {
        "doc": "选择录屏及已有黑流流程使用的稳扎稳打招募组合",
        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["稳扎稳打"],
        "roi": [0, 330, 1280, 210],
        "next": ["MiniGame@BlackFlow@ConfirmRecruitCombination", "#self"]
    },
    "MiniGame@BlackFlow@ConfirmRecruitCombination": {
        "doc": "复用已有黑流流程，确认选择稳扎稳打招募组合",
        "algorithm": "OcrDetect",
        "action": "ClickRect",
        "text": ["你确定要这么做"],
        "roi": [380, 535, 150, 30],
        "specificRect": [455, 595, 1, 1],
        "postDelay": 1000,
        "next": [
            "MiniGame@BlackFlow@RecruitVoucher1",
            "MiniGame@BlackFlow@ChooseRecruitCombination",
            "#self"
        ]
    },
    "MiniGame@BlackFlow@RecruitVoucher1": {
        "doc": "点击任意一张剩余招募券的招募按钮",
        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["招募"],
        "fullMatch": true,
        "roi": [0, 500, 1280, 180],
        "next": ["MiniGame@BlackFlow@GiveUpRecruit1", "#self"]
    },
    "MiniGame@BlackFlow@GiveUpRecruit1": {
        "doc": "在干员列表底部点击放弃",
        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["放弃"],
        "fullMatch": true,
        "roi": [850, 580, 200, 140],
        "next": ["MiniGame@BlackFlow@GiveUpRecruitConfirm1", "#self"]
    },
    "MiniGame@BlackFlow@GiveUpRecruitConfirm1": {
        "doc": "复用肉鸽放弃招募确认模板",
        "algorithm": "MatchTemplate",
        "action": "ClickSelf",
        "template": "Roguelike@StageEncounterGiveUpRecruitConfirm.png",
        "roi": [613, 410, 424, 171],
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@RecruitVoucher2", "#self"]
    },
    "MiniGame@BlackFlow@RecruitVoucher2": {
        "baseTask": "MiniGame@BlackFlow@RecruitVoucher1",
        "next": ["MiniGame@BlackFlow@GiveUpRecruit2", "#self"]
    },
    "MiniGame@BlackFlow@GiveUpRecruit2": {
        "baseTask": "MiniGame@BlackFlow@GiveUpRecruit1",
        "next": ["MiniGame@BlackFlow@GiveUpRecruitConfirm2", "#self"]
    },
    "MiniGame@BlackFlow@GiveUpRecruitConfirm2": {
        "baseTask": "MiniGame@BlackFlow@GiveUpRecruitConfirm1",
        "template": "Roguelike@StageEncounterGiveUpRecruitConfirm.png",
        "next": ["MiniGame@BlackFlow@RecruitVoucher3", "#self"]
    },
    "MiniGame@BlackFlow@RecruitVoucher3": {
        "baseTask": "MiniGame@BlackFlow@RecruitVoucher1",
        "next": ["MiniGame@BlackFlow@GiveUpRecruit3", "#self"]
    },
    "MiniGame@BlackFlow@GiveUpRecruit3": {
        "baseTask": "MiniGame@BlackFlow@GiveUpRecruit1",
        "next": ["MiniGame@BlackFlow@GiveUpRecruitConfirm3", "#self"]
    },
    "MiniGame@BlackFlow@GiveUpRecruitConfirm3": {
        "baseTask": "MiniGame@BlackFlow@GiveUpRecruitConfirm1",
        "template": "Roguelike@StageEncounterGiveUpRecruitConfirm.png",
        "next": ["MiniGame@BlackFlow@ChooseTreeSea", "#self"]
    },
    "MiniGame@BlackFlow@ChooseTreeSea": {
        "doc": "复用已有黑流流程，识别并点击沉沦于树海以开始探索",
        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["沉沦于树海"],
        "roi": [1060, 395, 160, 55],
        "postDelay": 5000,
        "next": ["MiniGame@BlackFlow@WaitForFirstLayer", "#self"]
    },
    "MiniGame@BlackFlow@WaitForFirstLayer": {
        "doc": "点击沉沦于树海后等待第一层地图加载",
        "algorithm": "JustReturn",
        "action": "DoNothing",
        "postDelay": 1000,
        "maxTimes": 20,
        "exceededNext": ["Stop"],
        "next": ["MiniGame@BlackFlow@OpenPartsBox", "#self"]
    },
    "MiniGame@BlackFlow@OpenPartsBox": {
        "doc": "用行动力标识确认地图加载完成，再点击底部零件箱",
        "algorithm": "OcrDetect",
        "action": "ClickRect",
        "text": ["行动力"],
        "roi": [1000, 50, 230, 120],
        "specificRect": [710, 650, 1, 1],
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@PartsBoxReady", "#self"]
    },
    "MiniGame@BlackFlow@PartsBoxReady": {
        "doc": "只识别零件箱；BlackFlowDataCollectionTaskPlugin 在此保存完整截图",
        "algorithm": "OcrDetect",
        "action": "DoNothing",
        "text": ["零件箱容量"],
        "roi": [0, 300, 400, 170],
        "preDelay": 1000,
        "next": ["MiniGame@BlackFlow@ClosePartsBox"]
    },
    "MiniGame@BlackFlow@ClosePartsBox": {
        "doc": "点击底部收起按钮关闭零件箱",
        "algorithm": "JustReturn",
        "action": "ClickRect",
        "specificRect": [640, 660, 1, 1],
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@ExitExploration", "#self"]
    },
    "MiniGame@BlackFlow@ExitExploration": {
        "doc": "复用肉鸽退出探索模板返回探索总览",
        "algorithm": "MatchTemplate",
        "action": "ClickSelf",
        "template": "Roguelike@ExitThenAbandon.png",
        "roi": [0, 0, 90, 90],
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@Abandon", "#self"]
    },
    "MiniGame@BlackFlow@Abandon": {
        "doc": "识别探索总览中的放弃本次探索入口",
        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["放弃本次探索"],
        "roi": [950, 270, 310, 130],
        "postDelay": 500,
        "next": ["MiniGame@BlackFlow@AbandonConfirm", "#self"]
    },
    "MiniGame@BlackFlow@AbandonConfirm": {
        "doc": "复用肉鸽放弃探索确认动作",
        "baseTask": "Roguelike@AbandonConfirm",
        "template": "Roguelike@AbandonConfirm.png",
        "postDelay": 1000,
        "next": ["MiniGame@BlackFlow@WaitForExploreRestart", "#self"]
    },
    "MiniGame@BlackFlow@WaitForExploreRestart": {
        "doc": "推进结算弹窗，直到再次识别到开始探索，一个采集周期结束",
        "algorithm": "JustReturn",
        "action": "ClickRect",
        "specificRect": [600, 610, 1, 1],
        "postDelay": 1500,
        "maxTimes": 20,
        "exceededNext": ["Stop"],
        "next": ["MiniGame@BlackFlow@StartExplore", "MiniGame@BlackFlow@WaitInitializing", "#self"]
    },
    "MiniGame@BlackFlow@WaitInitializing": {
        "doc": "初始化期间只等待，不额外点击",
        "algorithm": "OcrDetect",
        "action": "DoNothing",
        "text": ["正在初始化"],
        "roi": [1075, 590, 150, 60],
        "postDelay": 1000,
        "next": ["MiniGame@BlackFlow@StartExplore", "MiniGame@BlackFlow@WaitForExploreRestart"]
    }
}
