void require(bool value, const char* message)
{
    if (!value) {
        throw std::runtime_error(message);
    }
}

struct Scenario
{
    RoguelikeStageEncounterTaskPlugin plugin;
    json::array events;
    std::string fail_phase;
    int route_updates = 0;

    Scenario(std::string name = "古米", int elite = 1, int choice = 0, int destination = 3)
    {
        static std::uint64_t page_revision = 0;
        plugin.m_expedition_context = blackflow::ExpeditionContext { 1, ++page_revision, 2, { name } };
        plugin.config.value.opers[name].elite = elite;
        plugin.m_option_list[0].enabled = choice == 0;
        plugin.m_option_list[1].enabled = choice == 1;
        plugin.controller.after_depart = { destination };
        plugin.m_expedition_dispatch_observer = [&](auto) {
            ++route_updates;
        };
        plugin.m_expedition_evidence_observer = [&](auto phase, json::object details, const cv::Mat& im) {
            if (phase == fail_phase) {
                return false;
            }
            events.emplace_back(
                json::object { { "phase", std::string(phase) },
                               { "details", std::move(details) },
                               { "has_image", !im.empty() } });
            return true;
        };
        require(plugin.capture_expedition_candidates(plugin.ctrler()->get_image()), "candidate save");
    }

    bool choose() { return plugin.handle_expedition_choice(); }

    bool dispatch() { return plugin.handle_expedition_picker(); }

    int count(std::string_view phase) const
    {
        int n = 0;
        for (const auto& e : events) {
            n += e.get("phase", std::string()) == phase;
        }
        return n;
    }
};

int main(int argc, char** argv)
{
    int passed = 0, failed = 0;
    json::array fixtures;
    const auto test = [&](const std::string& name, auto&& body) {
        try {
            body();
            ++passed;
        }
        catch (const std::exception& e) {
            ++failed;
            std::cerr << "FAIL " << name << ": " << e.what() << '\n';
        }
    };
    for (auto name : { "古米", "伊桑", "凯尔希·思衡托" }) {
        for (int elite : { -1, 1, 2 }) {
            for (int choice : { 0, 1 }) {
                for (int page : { 3, 4 }) {
                    test(
                        std::string(name) + std::to_string(elite) + std::to_string(choice) + std::to_string(page),
                        [&] {
                            Scenario s(name, elite, choice, page);
                            require(s.choose(), "choice rejected");
                            require(s.dispatch(), "dispatch failed");
                            require(
                                s.count("choice_confirmed") == 1 && s.count("dispatch_confirmed") == 1 &&
                                    s.route_updates == 1,
                                "missing/duplicate archive dispatch");
                            require(s.plugin.controller.depart_clicks == 1, "depart duplicated");
                            const auto& details = s.events.at(s.events.size() - 1).at("details");
                            require(details.get("operator_name", std::string()) == name, "wrong actual name");
                            require(
                                details.get("selected_option_index_from_top", 0) == choice + 1,
                                "wrong choice base");
                            require(
                                elite < 0 ? details.at("elite_before").is_null()
                                          : details.get("elite_before", -1) == elite,
                                "pre-dispatch elite mutated");
                            require(
                                s.plugin.confirm_expedition_dispatch(
                                    s.plugin.controller.get_image(),
                                    "map_after_depart"),
                                "idempotence rejected");
                            require(
                                s.count("dispatch_confirmed") == 1 && s.route_updates == 1,
                                "duplicate callback counted twice");
                            if (std::string_view(name) == "凯尔希·思衡托" && elite == 1) {
                                require(
                                    s.plugin.config.value.opers[name].elite == (choice == 0 ? 2 : 1),
                                    "core promotion behavior changed");
                            }
                            if (elite == 1) {
                                for (const auto& e : s.events) {
                                    fixtures.emplace_back(e);
                                }
                            }
                        });
                }
            }
        }
    }
    for (const auto phase : { "choice_planned",
                              "choice_attempt",
                              "choice_click_issued",
                              "choice_confirmed",
                              "dispatch_prepared",
                              "dispatch_attempt",
                              "dispatch_click_issued",
                              "secondary_event",
                              "dispatch_confirmed" }) {
        test(std::string("persistence failure ") + phase, [&] {
            Scenario s;
            s.fail_phase = phase;
            if (s.choose()) {
                (void)s.dispatch();
            }
            require(!s.plugin.parent.enabled, "failure did not stop parent");
            require(s.count("dispatch_confirmed") == 0 && !s.route_updates, "failed persistence committed dispatch");
            if (std::string_view(phase) == "dispatch_prepared") {
                require(!s.plugin.controller.depart_clicks, "depart before saved image");
            }
        });
    }
    test("ineffective option clicks", [&] {
        Scenario s;
        s.plugin.controller.choice_effective = false;
        require(!s.choose(), "ineffective choice accepted");
        require(s.plugin.controller.choice_clicks == 3 && !s.count("choice_confirmed"), "choice retry/receipt wrong");
    });
    test("input rejection", [&] {
        Scenario s;
        s.plugin.controller.input_ok = false;
        require(!s.choose(), "input rejection ignored");
        require(!s.count("choice_confirmed") && s.count("choice_input_failed") == 3, "failed input confirmed");
    });
    test("departure rejection", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.controller.depart_ok = false;
        require(!s.dispatch(), "failed departure accepted");
        require(!s.count("dispatch_confirmed") && !s.route_updates, "departure failure fact");
    });
    for (int page : { 2, 5, 7, 8, 9, 10, 11 }) {
        test("bounded unconfirmed page " + std::to_string(page), [&] {
            Scenario s("古米", 1, 0, page);
            require(s.choose(), "choice");
            require(!s.dispatch(), "unconfirmed page accepted");
            require(!s.plugin.parent.enabled && !s.count("dispatch_confirmed"), "timeout did not stop");
        });
    }
    test("transition saved before advance", [&] {
        Scenario s;
        s.plugin.controller.after_depart = { 6, 5, 3 };
        require(s.choose() && s.dispatch(), "transition failed");
        require(
            s.count("transition_before_advance") == 1 && s.plugin.controller.advances == 1,
            "transition evidence gap");
    });
    test("transition save failure prevents advance", [&] {
        Scenario s;
        s.fail_phase = "transition_before_advance";
        s.plugin.controller.after_depart = { 6 };
        require(s.choose(), "choice");
        require(!s.dispatch() && !s.plugin.controller.advances, "advanced past failed image");
    });
    test("unstable OCR cannot dispatch", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.controller.unstable_names = true;
        (void)s.dispatch();
        require(!s.plugin.controller.depart_clicks && !s.count("dispatch_confirmed"), "unstable name dispatched");
    });
    test("unavailable operators cancel", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.controller.names = { "其他干员" };
        require(s.dispatch(), "cancel failed");
        require(s.count("cancelled") == 1 && !s.count("dispatch_confirmed"), "cancel became success");
    });
    test("cancel back failure stops", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.controller.names = { };
        s.plugin.controller.back_ok = false;
        require(!s.dispatch() && !s.plugin.parent.enabled, "back failure not stopped");
    });
    test("user stop is unresolved", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.controller.stopped = true;
        require(!s.dispatch() && !s.count("dispatch_confirmed"), "user stop dispatch");
    });
    test("empty frames do not confirm", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.controller.empty = true;
        require(!s.dispatch() && !s.count("dispatch_confirmed"), "empty confirmed");
    });
    test("no candidate archive no choice input", [&] {
        Scenario s;
        s.plugin.m_expedition_evidence.candidates_saved = false;
        require(!s.choose() && !s.plugin.controller.choice_clicks, "choice without candidates");
    });
    test("no choice receipt no dispatch", [&] {
        Scenario s;
        s.plugin.controller.page = 2;
        require(!s.dispatch() && !s.plugin.controller.depart_clicks, "untracked picker dispatched");
    });
    test("run reset clears pending evidence", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.m_expedition_pending_operator = "古米";
        s.plugin.reset_in_run_variables();
        require(
            !s.plugin.m_expedition_initial_choice && s.plugin.m_expedition_pending_operator.empty() &&
                !s.plugin.m_expedition_evidence.candidates_saved,
            "state leaked into new run");
    });
    test("new event resets selection", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.m_expedition_context_provider = [] {
            return std::optional(blackflow::ExpeditionContext { 1, 3, 2, { "伊桑" } });
        };
        s.plugin.refresh_expedition_context();
        require(
            !s.plugin.m_expedition_initial_choice && !s.plugin.m_expedition_evidence.candidates_saved,
            "selection leaked into next node");
    });
    test("context switch cannot confirm pending dispatch", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.m_expedition_pending_operator = "古米";
        s.plugin.m_expedition_context_provider = [] {
            return std::optional(blackflow::ExpeditionContext { 2, 3, 2, { "伊桑" } });
        };
        s.plugin.refresh_expedition_context();
        require(!s.plugin.parent.enabled && !s.route_updates, "stale dispatch committed");
    });
    test("ordinary mode still returns from picker", [&] {
        Scenario s;
        s.plugin.m_expedition_context.reset();
        s.events.clear();
        require(s.dispatch() && s.plugin.controller.back_clicks == 1 && s.events.empty(), "ordinary picker changed");
    });
    test("choice text change does not reuse old planned identity", [&] {
        Scenario s;
        require(s.choose(), "choice");
        const auto clicks = s.plugin.controller.choice_clicks;
        s.plugin.m_option_list[0].text = "其他选项";
        require(!s.choose() && s.plugin.controller.choice_clicks == clicks, "clicked changed choice");
    });
    test("ambiguous branch text stays unknown", [&] {
        Scenario s;
        s.plugin.m_option_list[0].text = "探索内部或源头";
        require(s.choose() && s.dispatch(), "dispatch");
        require(
            s.events.at(s.events.size() - 1).at("details").at("selected_branch").is_null(),
            "ambiguous text inferred");
    });
    test("stop immediately after departure is unresolved", [&] {
        Scenario s;
        require(s.choose(), "choice");
        s.plugin.controller.stop_on_depart = true;
        require(!s.dispatch() && !s.count("dispatch_confirmed") && !s.route_updates, "stop became confirmation");
    });
    test("failed final persistence precedes predicted elite mutation", [&] {
        Scenario s("凯尔希·思衡托");
        s.fail_phase = "dispatch_confirmed";
        require(s.choose() && !s.dispatch(), "save failure ignored");
        require(
            s.plugin.config.value.opers["凯尔希·思衡托"].elite == 1 && !s.route_updates,
            "predicted upgrade committed before evidence");
    });
    test("each animation advance has its own saved frame", [&] {
        Scenario s;
        s.plugin.controller.after_depart = { 6, 6, 6, 3 };
        require(s.choose() && s.dispatch(), "transition failed");
        require(s.count("transition_before_advance") == 3 && s.plugin.controller.advances == 3, "uncaptured advance");
    });
    test("failed advance input is unresolved", [&] {
        Scenario s;
        s.plugin.controller.after_depart = { 6 };
        s.plugin.controller.advance_ok = false;
        require(s.choose() && !s.dispatch() && !s.count("dispatch_confirmed"), "failed advance confirmed");
    });
    test("unavailable choices leave without dispatch", [&] {
        Scenario s;
        s.plugin.m_option_list[0].enabled = false;
        require(
            s.choose() && s.count("cancelled") == 1 && !s.plugin.controller.choice_clicks,
            "no enabled choice unrecorded");
    });
    test("no eligible operator leaves a cancellation reason before any choice", [&] {
        Scenario s;
        s.plugin.m_expedition_context->operators.clear();
        require(
            s.choose() && s.count("cancelled") == 1 && !s.plugin.controller.choice_clicks,
            "no eligible operator unrecorded");
    });
    test("candidate arrays are produced once from the recognized options", [&] {
        Scenario s;
        require(s.plugin.capture_expedition_candidates(s.plugin.controller.get_image()), "repeat candidates");
        require(
            s.count("candidates") == 1 && s.events[0].at("details").at("candidates").as_array().size() == 3,
            "candidate list missing or duplicated");
    });
    test("candidate write failure stops before any choice", [&] {
        Scenario s;
        s.plugin.m_expedition_evidence.candidates_saved = false;
        s.fail_phase = "candidates";
        require(
            !s.plugin.capture_expedition_candidates(s.plugin.controller.get_image()) && !s.plugin.parent.enabled &&
                !s.plugin.controller.choice_clicks,
            "candidate save failure ignored");
    });
    test("empty candidate frame is unresolved", [&] {
        Scenario s;
        s.plugin.m_expedition_evidence.candidates_saved = false;
        require(
            !s.plugin.capture_expedition_candidates({ }) && !s.plugin.parent.enabled &&
                !s.plugin.controller.choice_clicks,
            "empty candidates accepted");
    });
    test("outside floor two keeps the ordinary expedition leave behavior", [&] {
        Scenario s;
        s.events.clear();
        s.plugin.m_expedition_context_provider = [] {
            return std::optional(blackflow::ExpeditionContext { 1, 9, 3, { } });
        };
        s.plugin.refresh_expedition_context();
        require(
            !s.plugin.m_expedition_context && s.dispatch() && s.plugin.parent.enabled && s.events.empty(),
            "non-target floor acquired collection guards");
    });
    /*encounter_tests*/
    if (argc > 2) {
        test("shared payload fixture matches actual producer methods", [&] {
            require(json::open(argv[2]).value() == json::value(fixtures), "producer payload fixture drifted");
        });
    }
    if (argc > 1) {
        std::ofstream stream(argv[1]);
        stream << json::value(std::move(fixtures)).to_string();
    }
    std::cout << passed << " passed, " << failed << " failed\n";
    return failed ? 1 : 0;
}
