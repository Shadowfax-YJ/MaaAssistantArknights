inline bool sacrifice_item_selected(const cv::Mat&, const Rect&) { return true; }
inline std::string sacrifice_selected_name(const cv::Mat&) { return "种子"; }
}

struct OCRer
{
    struct Result
    {
        std::string text;
    };

    std::vector<Result> result;
    cv::Mat im;
    std::string task;

    OCRer(const cv::Mat& image) :
        im(image)
    {
    }

    void set_task_info(std::string_view value) { task = value; }

    bool analyze()
    {
        result.clear();
        if (im.empty()) {
            return false;
        }
        auto page = im.at<cv::Vec3b>(0, 0)[0];
        if (task.ends_with("ExpeditionOperDescription") && page == 2) {
            int slot = int(im.at<cv::Vec3b>(0, 0)[1]) - 1;
            if (slot >= 0 && slot < int(active->names.size())) {
                static int sample = 0;
                result.push_back(
                    { "干员" + (active->unstable_names && ++sample % 2 ? "未确认" : active->names[slot]) +
                      "将会在本区域探索" });
            }
        }
        else if (task.ends_with("StageEncounterOcr") && (page == 3 || page == 7 || page == 8 || page == 10)) {
            result.push_back({ page == 7 ? "其他事件" : "未涉足之树" });
        }
        else if (task == "LoadingText" && (page == 5 || page == 9)) {
            result.push_back({ "Loading" });
        }
        else if (task.ends_with("DataSyncConfirm") && (page == 10 || page == 11)) {
            result.push_back({ "数据已更新" });
        }
        return !result.empty();
    }

    const auto& get_result() const { return result; }
};

struct Matcher
{
    cv::Mat im;
    std::string task;

    Matcher(const cv::Mat& image) :
        im(image)
    {
    }

    void set_task_info(const std::string& value) { task = value; }

    bool analyze() const
    {
        if (im.empty()) {
            return false;
        }
        int page = im.at<cv::Vec3b>(0, 0)[0];
        return (task.ends_with("CloseCollection") && page == 13) ||
               (task.ends_with("ExpeditionPicker") && (page == 2 || page == 8)) ||
               ((task.ends_with("MapPrepare-Ready") || task.ends_with("MapPrepare-ZoomOut")) &&
                (page == 4 || page == 9 || page == 11));
    }
};

struct PipelineAnalyzer : Matcher
{
    using Matcher::Matcher;

    void set_tasks(std::initializer_list<std::string> tasks) { task = *tasks.begin(); }
};
class RoguelikeStageEncounterTaskPlugin;

struct ProcessTask
{
    RoguelikeStageEncounterTaskPlugin& plugin;
    std::string task;

    ProcessTask(RoguelikeStageEncounterTaskPlugin& p, std::initializer_list<std::string> tasks) :
        plugin(p),
        task(*tasks.begin())
    {
    }

    auto& set_retry_times(int) { return *this; }

    bool run();
};

class RoguelikeStageEncounterTaskPlugin
{
public:
    ReplayConfig config;
    ReplayConfig* m_config = &config;
    ReplayParent parent;
    ReplayParent* m_task_ptr = &parent;
    ReplayController controller;

    struct Option
    {
        bool enabled = true;
        cv::Mat templ;
        std::string text, red_description;
    };

    std::vector<Option> m_option_list { { true, { }, "尝试探索树的内部", "" },
                                        { false, { }, "尝试探索树的源头", "" },
                                        { true, { }, "离开", "" } };
    std::vector<int> m_option_y_in_view { 100, 200, 300 };
    cv::Mat m_option_list_image;
    std::optional<blackflow::ExpeditionContext> m_expedition_context;
    std::function<std::optional<blackflow::ExpeditionContext>()> m_expedition_context_provider;
    std::function<void(std::string_view)> m_expedition_dispatch_observer;
    std::function<bool(std::string_view, json::object, const cv::Mat&)> m_expedition_evidence_observer;
    std::string m_expedition_pending_operator;
    bool m_expedition_finished = false;
    std::optional<size_t> m_expedition_initial_choice;

    struct ExpeditionEvidence
    {
        json::object details;
        int sequence = 0, choice_attempt = 0, dispatch_attempt = 0;
        bool candidates_saved = false, choice_clicked = false, choice_confirmed = false, failed = false;
        cv::Mat confirmation_image;
        std::string confirmation_basis;
    } m_expedition_evidence;

    /*m_sacrifice*/
    /*m_encounter_choice*/
    std::function<std::optional<blackflow::SacrificeContext>()> m_sacrifice_context_provider;
    std::function<bool(std::string_view, std::string_view, json::object, const cv::Mat&)> m_event_detail_observer;
    int m_lake_fairy_initial_choice_index = 0;
    std::optional<int> m_lake_fairy_plan;
    bool m_lake_fairy_unique_choice_selected = false;

    bool need_exit() const { return controller.stopped; }

    void sleep(int) { }

    auto* ctrler()
    {
        active = &controller;
        return &controller;
    }

    bool move_to_analyzed_option(size_t) { return true; }

    std::optional<Rect> wait_for_analyzed_option_stable(size_t) { return Rect { 100, 100, 100, 30 }; }

    int hp(const cv::Mat&) { return -1; }

    static bool save_img(const cv::Mat&, std::string_view) { return true; }

    std::optional<std::string> next_event(const std::string&)
    {
        ++controller.advances;
        return std::nullopt;
    }

    void refresh_expedition_context();
    bool capture_expedition_candidates(const cv::Mat&);
    bool report_expedition(std::string_view, json::object = { }, const cv::Mat& = { });
    bool abort_expedition(std::string_view);
    bool handle_expedition_choice();
    bool confirm_expedition_dispatch(const cv::Mat&, std::string_view);
    bool wait_for_secondary_event(std::string_view);
    bool handle_expedition_picker();
    bool select_analyzed_option(size_t);
    void reset_in_run_variables();
    bool report_encounter_choice(std::string_view, json::object = {}, const cv::Mat& = {});
    bool prepare_encounter_choice(std::string_view, int, const cv::Mat&);
    bool plan_encounter_choice(size_t, std::string_view);
    bool randomize_encounter_choice_order(std::vector<size_t>&);
    bool confirm_encounter_choice(const cv::Mat&, std::string_view);
    bool confirm_cargo_choice();
    bool refresh_sacrifice_context();
    bool report_sacrifice(std::string_view, json::object, const cv::Mat&);
    bool handle_sacrifice_event();
    bool handle_sacrifice_picker();
    bool finish_sacrifice_civilization();
    std::optional<std::vector<std::string>> scan_sacrifice_natural_items(std::string_view) { return std::vector<std::string>{"种子"}; }
    json::object basic_info_with_what(const char*) { return {}; }
    void callback(AsstMsg, json::object) {}
    struct OptionAnalyzer {
        cv::Mat image;
        std::vector<Option> options;
        OptionAnalyzer(const cv::Mat& im):image(im){}
        void set_theme(const std::string&) {}
        bool analyze() {
            if (image.empty()) return false;
            int page=image.at<cv::Vec3b>(0,0)[0];
            options = page == 2 ? std::vector<Option>{{true,{},"领取奖励",""}} : std::vector<Option>{{true,{},"原始选项",""}};
            return true;
        }
        const auto& get_result() const {return options;}
    };
};

bool ProcessTask::run()
{
    auto& c = plugin.controller;
    if (plugin.need_exit()) {
        return false;
    }
    if (task.ends_with("ExpeditionDepart")) {
        if (!c.depart_ok) {
            return false;
        }
        ++c.depart_clicks;
        if (c.stop_on_depart) {
            c.stopped = true;
        }
        return true;
    }
    if (task.ends_with("ExpeditionBack")) {
        ++c.back_clicks;
        return c.back_ok;
    }
    if (task.ends_with("StageEncounterLeaveConfirm")) {
        return c.page == 2;
    }
    if (task.ends_with("SacrificeConfirm")) c.page = 3;
    return true;
}
}

