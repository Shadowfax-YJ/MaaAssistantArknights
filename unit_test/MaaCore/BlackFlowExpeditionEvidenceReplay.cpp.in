struct ReplayConfig
{
    struct Oper
    {
        int elite = 1;
    };

    struct Status
    {
        std::map<std::string, Oper> opers;
    } value;

    std::string theme = "BlackFlow";

    auto& status() { return value; }

    auto& get_theme() { return theme; }
};

struct ReplayParent
{
    bool enabled = true;

    void set_enable(bool value) { enabled = value; }
};

struct ReplayController
{
    int page = 1, selected_slot = -1, choice_clicks = 0, depart_clicks = 0, back_clicks = 0, advances = 0;
    bool input_ok = true, choice_effective = true, depart_ok = true, back_ok = true, stopped = false;
    bool unstable_names = false, empty = false, stop_on_depart = false, advance_ok = true;
    std::vector<int> after_depart { 3 };
    size_t next_frame = 0;
    std::vector<std::string> names { "古米", "伊桑", "凯尔希·思衡托" };

    cv::Mat get_image()
    {
        if (empty) {
            return { };
        }
        if (depart_clicks && next_frame < after_depart.size()) {
            page = after_depart[next_frame++];
        }
        cv::Mat im(720, 1280, CV_8UC3, cv::Scalar());
        im.at<cv::Vec3b>(0, 0)[0] = page;
        im.at<cv::Vec3b>(0, 0)[1] = selected_slot + 1;
        return im;
    }

    bool click(const Point&)
    {
        ++choice_clicks;
        if (input_ok && choice_effective) {
            page = 2;
        }
        return input_ok;
    }

    bool click(const Rect& rect)
    {
        if (rect.x == 600) {
            if (!advance_ok) {
                return false;
            }
            ++advances;
            return true;
        }
        if (!input_ok) {
            return false;
        }
        selected_slot = (rect.x - 685) / 113;
        return true;
    }
};

inline ReplayController* active;
constexpr std::string_view Prefix = "BlackFlow@Roguelike@";
inline size_t random_index(size_t) { return 0; }
inline bool recognize(const cv::Mat& image, std::string_view suffix) {
    const int page = image.empty() ? 0 : image.at<cv::Vec3b>(0, 0)[0];
    return (suffix == "SacrificePicker" && page == 2) || (suffix.starts_with("MapPrepare-") && page == 4) ||
           (suffix == "SacrificePopupClose" && page == 12);
}
