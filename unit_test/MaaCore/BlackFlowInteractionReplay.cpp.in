    test("whole inventory stops on the captured 002 OCR before its jittering empty tail",[&]{
        using namespace whole_inventory_replay;
        const auto fixture=std::filesystem::path(argv[1]).parent_path()/"blackflow-inventory/20261021-instance002/runtime-ocr-layouts.json";
        const auto data=json::open(fixture);
        check(data.has_value(),"captured runtime OCR fixture missing");
        std::vector<std::vector<TextRect>> pages;
        for(const auto& page:data->as_array()){
            std::vector<TextRect> names;
            for(const auto& name:page.at("names").as_array()){
                const auto& r=name.at("rect").as_array();
                names.emplace_back(TextRect{{r[0].as_integer(),r[1].as_integer(),r[2].as_integer(),r[3].as_integer()},
                                            name.at("score").as_double(),name.at("text").as_string()});
            }
            pages.emplace_back(std::move(names));
        }
        whole_inventory_replay::BlackFlowMovementTaskPlugin p;configure(p,std::move(pages));
        // 这是已经完成回到起点后的前向观测序列；重复末帧不是不同的物理列。
        p.controller.page=0;
        whole_inventory_replay::BlackFlowMovementTaskPlugin::InventoryFrame frame;std::string error;
        check(p.scan_inventory_frame(frame,&error),error.c_str());
        check(frame.scan_complete&&frame.movement_instances.size()==2,"captured initial-page movements lost");
        check(p.controller.forward_swipes==0,"captured explicit empty slots were ignored");
    });
