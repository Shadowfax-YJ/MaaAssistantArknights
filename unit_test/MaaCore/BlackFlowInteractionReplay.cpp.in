        test(("reset recovery failure remains bounded "+std::to_string(failure)).c_str(),[&]{
            whole_inventory_replay::BlackFlowMovementTaskPlugin p;reset_replay(p,"MAA-003");p.controller.settle_on_wait=false;
            if(failure==0)p.controller.collapse_ok=false;
            if(failure==1)p.controller.stuck_expanded=true;
            if(failure==2)p.controller.expand_ok=false;
            if(failure==3)p.controller.unstable_after_reopen=true;
            whole_inventory_replay::BlackFlowMovementTaskPlugin::InventoryFrame frame;std::string error;
            check(!p.scan_inventory_frame(frame,&error)&&!frame.scan_complete,"unverified recovery completed the scan");
            check(p.controller.collapses<=2&&p.controller.expands<=1&&p.waits<50,"recovery exceeded its budget");
            check(!frame.images.empty(),"failed reset discarded its last frame");
        });
    }
