struct Plugin {
    Config config;
    Config* m_config=&config;
    ParentTask parent;
    ParentTask* m_task_ptr=&parent;
    RoguelikeCustomType m_waiting_to_run=RoguelikeCustomType::Reward;
    Controller controller;
    std::uint64_t m_start_reward_observation_index=0;
    bool m_blackflow_roles_verified=false, m_blackflow_opening_failed=false;
    std::function<void(std::string_view)> m_blackflow_start_reward_observer;
    std::function<bool(std::string_view,json::object,std::shared_ptr<cv::Mat>)> m_blackflow_start_reward_evidence_observer;
    std::function<bool(std::string_view,json::object,std::shared_ptr<cv::Mat>)> m_blackflow_opening_evidence_observer;
    std::string fail_save;
    std::vector<std::string> confirmed;
    std::vector<json::value> events;
    Plugin() {
        blackflow::unknown_destination=false;
        OCRer::show_prompt=true;OCRer::title_reads=0;
        OCRer::titles=std::vector<TextRect>{
            {{120,400,140,28},0.99,"调查预付款"}, {{380,400,140,28},0.83,"强裸骏鹰"},
            {{640,400,140,28},0.92,"空间租货"}, {{900,400,140,28},0.97,"林间代步"},
            {{1130,420,20,20},0.5,"???"}};
        m_blackflow_start_reward_observer=[this](std::string_view name){confirmed.emplace_back(name);};
        m_blackflow_start_reward_evidence_observer=[this](std::string_view kind,json::object details,std::shared_ptr<cv::Mat> image){
            if(kind==fail_save)return false;
            const bool selected=kind=="selected", confirming=kind=="confirming", failed=kind=="failed";
            if(confirming)check(!image&&controller.stage==1,"pending identity must precede confirmation click");
            if(selected){check(!image&&controller.stage==2,"selection must be confirmed before recording");}
            else if(kind=="candidates"){
                check(controller.clicks==0,"candidate evidence must be saved before clicking");
                check(image&&!image->empty()&&image->at<cv::Vec3b>(0,0)[0]==0,"must preserve the actual OCR frame");
            }
            events.emplace_back(json::object{{"action","start.reward."+std::string(kind)},
                {"phase",confirming?"before-click":selected||failed?"completed":"observed"},
                {"outcome",selected?"confirmed":failed?"failed":confirming?"pending":details.get("recognition_status",std::string())},
                {"details",std::move(details)},{"level",failed?"WARN":"INFO"},
                {"task","RoguelikeCustomStartTaskPlugin"},{"state",json::object{}},{"floor",0},{"map_generation",0}});
            return true;
        };
    }
    Controller* ctrler(){return &controller;}
    bool sleep(int){return true;}
    bool need_exit(){return false;}
    bool on_run_fails() /*START_REWARD_FAILURE*/
    bool run() {
        const bool automation_collection=true;
        /*START_REWARD*/
        return false;
    }
};
}
