struct OCRer {
    inline static std::optional<std::vector<TextRect>> titles;
    inline static bool show_prompt=true;
    inline static int title_reads=0;
    cv::Mat image;
    std::string task;
    explicit OCRer(const cv::Mat& value):image(value){}
    void set_task_info(std::string_view value){task=value;}
    void set_required(std::vector<std::string>){}
    void set_fuzzy_match(bool){}
    std::optional<std::vector<TextRect>> analyze() {
        if(task.ends_with("PreferredStartReward")){++title_reads;return titles;}
        if(show_prompt&&image.at<cv::Vec3b>(0,0)[0]==1)
            return std::vector<TextRect>{{{400,544,140,28},0.99,"你确定要这么做"}};
        return std::nullopt;
    }
};
