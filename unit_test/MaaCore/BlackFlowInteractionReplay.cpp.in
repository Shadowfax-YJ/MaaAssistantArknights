        check(!p.close_panel(&e),"one map frame accepted before panel returns");});
    auto load=[&](const char* file){auto image=cv::imread(std::string(argv[1])+"/"+file);check(!image.empty(),"fixture missing");return image;};
    if(argc<2)return 2;
    auto stuck=load("stuck-before.jpg"),still=load("stuck-after.jpg"),before=load("claim-before.jpg"),after=load("claim-after.jpg");
    std::vector<json::value> contract_events;
    test("stuck reward enters recovery then stops",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck,still};p.run();
        check(Task.next=="BlackFlow@Roguelike@RecoveryFailed"&&p.controller.clicks==3,"unchanged reward must leave click loop after three attempts");
        contract_events=p.events;
        p.run();check(p.m_session->failed&&p.controller.clicks==6,"second failed round must stop and preserve exploration");
        check(Task.next=="BlackFlow@Roguelike@StrategyTerminated-Enter","stop must reach lifecycle task by its own name");});
    test("reward successfully removed",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={before,after};p.run();
        contract_events.insert(contract_events.end(),p.events.begin(),p.events.end());
        check(p.controller.clicks==1&&!p.m_session->failed&&p.outcomes==std::vector<std::string>{"page_changed"},"successful claim must leave after one click");});
    test("touch dispatch fails",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck,still};p.controller.click_ok=false;p.run();p.run();
        check(p.m_session->failed&&p.controller.clicks==6,"touch errors must also be bounded");});
    test("recovery resumes successfully",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck,still};p.run();
        p.controller.stage=0;p.controller.frames={before,after};p.run();check(!p.m_session->failed&&p.m_stalled_reward_rounds==0,"progress must clear recovery budget");});
    test("new transaction has fresh recovery budget",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck,still};p.run();
        p.m_session->transaction="BF-T8-24";p.run();check(!p.m_session->failed&&p.m_stalled_reward_rounds==1,"old node failures must not leak to another node");});
    test("cancelled wait does not click again",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck,still};p.cancel_on_sleep=true;p.run();
        check(p.controller.clicks==1&&!p.m_session->failed,"user cancellation must interrupt retries");});
    test("capture fails before click",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck};p.m_capture=[](auto,auto,auto){return false;};p.run();p.run();
        check(p.controller.clicks==0&&p.m_session->failed,"missing stable evidence must never dispatch stale clicks or loop forever");});
    test("reward capture rejects a page that already entered recruitment",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck,after};
        // Recorded boundary: first evidence capture succeeds; the subsequent one rejects the old GetDrop page.
        // Deliberately keep the four progress probes unchanged, then transition at the next capture boundary.
        p.controller.click_ok=false;
        p.m_capture=[&](auto,auto,auto){if(++p.captures==1)return true;p.controller.stage=1;return false;};
        Matcher::reward_matches=[&](const cv::Mat& image){return cv::norm(image,after,cv::NORM_INF)!=0;};
        p.run();check(Task.next=="BlackFlow@Roguelike@GetDropConfirmedContinue"&&!p.m_session->failed,"successful transition entered recovery");
        check(p.controller.clicks==1,"already-open recruitment received another click");});
    test("page already changed before first capture",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={after};
        p.m_capture=[](auto,auto,auto){return false;};Matcher::reward_matches=[](auto&){return false;};p.run();
        check(p.controller.clicks==0&&Task.next=="BlackFlow@Roguelike@GetDropConfirmedContinue","pre-click transition must hand back to page dispatcher");});
    test("reward disappears during animated progress probes",[&]{BlackFlowNodeEvidenceTaskPlugin p;p.controller.frames={stuck,after};
        Matcher::reward_matches=[&](const cv::Mat& image){return cv::norm(image,after,cv::NORM_INF)!=0;};p.run();
        check(p.controller.clicks==1&&p.outcomes==std::vector<std::string>{"page_changed"},"destination page must count as transition");});
    test("abnormal BlackFlow stop cannot become successful task completion",[]{completion_replay::RoguelikeTask p;
        p.m_blackflow_session_ptr->value=completion_replay::Result{};
        check(!p.run(),"disabled parent was still reported as successful completion");
        const auto& e=p.m_blackflow_port_ptr->events.back();
        check(e.phase=="failed"&&e.outcome=="opening_selection_failed","task.finished lost the failure cause");});
    test("opening failure still reaches task error when diagnostic storage is unavailable",[]{completion_replay::RoguelikeTask p;
        p.m_custom_ptr->failed=true;
        check(!p.run()&&p.m_blackflow_session_ptr->result()->outcome=="opening_selection_failed",
              "task success still depended on successful failure logging");});
    for (const auto* outcome : {"encounter_choice_unresolved", "encounter_evidence_failed"})
    test("cargo unresolved choice or failed evidence cannot report task completed",[&]{completion_replay::RoguelikeTask p;
        p.m_blackflow_session_ptr->value=completion_replay::Result{false,"stop_task",outcome,"cargo choice failed"};
        check(!p.run(),"cargo stop was still successful at the task boundary");
        const auto& e=p.m_blackflow_port_ptr->events.back();
        check(e.phase=="failed"&&e.outcome==outcome,"cargo failure cause was not retained");});
    test("normal BlackFlow strategy ending stays successful",[]{completion_replay::RoguelikeTask p;
        p.m_blackflow_session_ptr->value=completion_replay::Result{true,"stop_run","completed","done"};
        check(p.run(),"normal strategy stop became task error");});
    test("ordinary themes keep package completion semantics",[]{completion_replay::RoguelikeTask p;
        p.m_config_ptr->theme=completion_replay::RoguelikeTheme::Other;
        p.m_blackflow_session_ptr->value=completion_replay::Result{};
        check(p.run(),"BlackFlow status changed another theme");});
    test("user stop stays cancelled without inventing a strategy failure",[]{completion_replay::RoguelikeTask p;
        p.cancelled=true;p.pipeline_success=false;
        check(!p.run()&&!p.m_blackflow_session_ptr->result(),"manual stop invented a collection failure");
        check(p.m_blackflow_port_ptr->events.back().phase=="stopped","manual stop was labeled task failure");});
    test("ordinary pipeline failure retains a failure outcome",[]{completion_replay::RoguelikeTask p;
        p.pipeline_success=false;
        check(!p.run()&&p.m_blackflow_session_ptr->result()->outcome=="task_pipeline_failed","pipeline failure was not retained");});
    test("planned run restart is not a task error",[]{completion_replay::RoguelikeTask p;
        p.m_blackflow_session_ptr->value=completion_replay::Result{false,"restart_current_run","unsupported_pursuit","restart"};
        check(p.run(),"planned restart changed task completion semantics");});
    std::vector<json::value> start_reward_events;
    test("opening popup reached through squad task is still a start reward",[]{
        check(collection_popup_source("BlackFlow@Roguelike@SquadConfirm@BlackFlow@Roguelike@CloseCollection")
            ==CollectionPopupSource::StartReward,"task name invented a squad reward source");});
    test("failed start reward plugin prevents parent fallback clicks",[]{start_reward_replay::Plugin p;
        check(!p.on_run_fails()&&!p.parent.enabled&&p.m_blackflow_opening_failed,"failed reward plugin left unrecorded confirmation fallback enabled");});
    test("failed combo selection stops parent and retains explicit failure without a logger",[]{start_reward_replay::Plugin p;
        p.m_waiting_to_run=start_reward_replay::RoguelikeCustomType::Roles;
        check(!p.on_run_fails()&&!p.parent.enabled&&p.m_blackflow_opening_failed,"combo failure disappeared at parent boundary");});
    test("start reward retains every raw OCR candidate and the confirmed selection",[&]{start_reward_replay::Plugin p;
        check(p.run(),"normal reward confirmation failed");check(p.events.size()==3,"candidate, pending and selection events missing");
        const auto& details=p.events[0].at("details");const auto& candidates=details.at("candidates").as_array();
        check(details.get("candidate_count",0)==5&&candidates.size()==5,"unselected or unknown OCR candidates were dropped");
        const auto& raw=*start_reward_replay::OCRer::titles;
        for(std::size_t i=0;i<raw.size();++i){
            check(candidates[i].get("detected_index",-1)==int(i),"OCR order was lost");
            check(candidates[i].get("text",std::string())==raw[i].text,"raw text changed");
            check(candidates[i].get("score",0.0)==raw[i].score,"OCR confidence changed");
            check(candidates[i].at("rect").to_string()==raw[i].to_json().at("rect").to_string(),"OCR rectangle changed");
        }
        check(candidates[1].get("canonical",std::string())=="襁褓骏鹰","fuzzy normalization was lost");
        check(candidates[2].get("canonical",std::string())=="空间租赁","unselected fuzzy candidate was lost");
        check(candidates[4].at("canonical").is_null(),"unknown text was invented as a reward");
        check(details.at("planned_selection").get("detected_index",-1)==1,"planned selection differs from click");
        check(p.controller.clicked==raw[1].rect&&p.controller.clicks==2,"existing click behavior changed");
        check(p.confirmed==std::vector<std::string>{"襁褓骏鹰"},"confirmed reward changed");
        check(p.events[2].at("details").get("selected_index",-1)==1,"selected candidate index missing");
        check(p.events[2].at("details").get("observation_index",0)==details.get("observation_index",-1),"selection not linked to candidates");
        check(start_reward_replay::OCRer::title_reads==1,"logging must not trigger another OCR");
        start_reward_events=p.events;});
    test("failed confirmation keeps candidates without claiming a reward",[&]{start_reward_replay::Plugin p;p.controller.confirm_ok=false;
        check(!p.run(),"failed confirmation reported success");
        check(p.events.size()==4&&p.confirmed.empty()&&p.events.back().get("action","")=="start.reward.failed","failed confirmation must keep pending identity and failure");
        check(p.controller.clicks==3,"confirmation retry budget changed");
        start_reward_events.insert(start_reward_events.end(),p.events.begin(),p.events.end());});
    test("missing prompt on an unknown page cannot confirm a reward",[]{start_reward_replay::Plugin p;
        start_reward_replay::blackflow::unknown_destination=true;
        check(!p.run()&&p.confirmed.empty(),"prompt disappearance was still treated as reward receipt");
        check(p.controller.clicks==2,"old reward coordinate clicked on the destination page");});
    test("missing confirmation prompt does not claim a reward",[]{start_reward_replay::Plugin p;start_reward_replay::OCRer::show_prompt=false;
        check(!p.run()&&p.events.size()==2&&p.confirmed.empty(),"missing prompt must keep candidates and failure");
        check(p.controller.clicks==1,"missing prompt dispatched another click");});
    test("OCR failure records an empty observation",[&]{start_reward_replay::Plugin p;start_reward_replay::OCRer::titles=std::nullopt;
        check(!p.run()&&p.events.size()==1&&p.controller.clicks==0,"OCR failure evidence missing or clicked blindly");
        const auto& d=p.events[0].at("details");
        check(d.get("recognition_status",std::string())=="no_titles"&&d.get("candidate_count",-1)==0,"empty OCR must not imply absent rewards");
        check(d.at("planned_selection").is_null(),"empty OCR invented a selection");
        start_reward_events.insert(start_reward_events.end(),p.events.begin(),p.events.end());});
    test("unrecognized text is retained without a selection",[&]{start_reward_replay::Plugin p;
        start_reward_replay::OCRer::titles=std::vector<TextRect>{{{300,400,80,28},0.5,"???"}};
        check(!p.run()&&p.events.size()==1&&p.controller.clicks==0,"unrecognized titles must retain evidence without clicking");
        const auto& d=p.events[0].at("details");
        check(d.at("candidates").as_array().size()==1&&d.at("planned_selection").is_null(),"unknown OCR result was dropped");
        start_reward_events.insert(start_reward_events.end(),p.events.begin(),p.events.end());});
    test("repeat selection uses a new observation index",[]{start_reward_replay::Plugin p;
        check(p.run(),"first reward selection failed");p.controller.stage=0;p.controller.clicks=0;
        start_reward_replay::OCRer::titles=std::vector<TextRect>{{{300,400,140,28},0.99,"调查预付款"}};
        check(p.run()&&p.events.size()==6,"second reward selection lost its candidate or confirmation");
        check(p.events[3].at("details").get("observation_index",0)==2&&p.events[5].at("details").get("observation_index",0)==2,"observations cannot be paired");
        check(p.events[3].at("details").get("candidate_count",0)==1,"second page inherited old candidates");
        check(p.confirmed==std::vector<std::string>{"襁褓骏鹰","调查预付款"},"multiple confirmed rewards changed");});
    test("candidate save failure stops before selecting",[]{start_reward_replay::Plugin p;p.fail_save="candidates";
        check(!p.run()&&p.controller.clicks==0&&p.confirmed.empty(),"unsaved candidates allowed a selection");});
    test("cultivation claim failure disables the opening parent",[]{start_reward_replay::Plugin p;
        p.m_waiting_to_run=start_reward_replay::RoguelikeCustomType::CultivationHarvest;
        check(!p.on_run_fails()&&!p.parent.enabled,"failed cultivation continued with fallback clicks");});
    test("pending identity save failure stops before confirming",[]{start_reward_replay::Plugin p;p.fail_save="confirming";
        check(!p.run()&&p.controller.clicks==1&&p.confirmed.empty(),"unsaved identity allowed reward receipt");});
    test("final record failure retains pending identity and stops parent",[]{start_reward_replay::Plugin p;p.fail_save="selected";
        check(!p.run()&&p.controller.stage==2&&p.confirmed.empty(),"failed durable selection was committed to session");
        check(p.events.size()==3&&p.events[1].get("action","")=="start.reward.confirming","pending identity lost after reward receipt");
        check(p.events.back().at("details").get("failure_reason","")=="selection_evidence_not_saved","failure reason missing");
        check(!p.on_run_fails()&&!p.parent.enabled,"failed save continued with fallback clicks");});
    test("hydra title is recorded without changing the selection policy",[]{start_reward_replay::Plugin p;
        start_reward_replay::OCRer::titles=std::vector<TextRect>{{{120,400,140,28},0.99,"襁褓九头蛇"},{{380,400,140,28},0.99,"林间代步"}};
        check(p.run()&&p.confirmed==std::vector<std::string>{"林间代步"},"recording Hydra changed preference");
        check(p.events[0].at("details").at("candidates").as_array()[0].get("canonical","")=="襁褓九头蛇","known offered option omitted");});
    test("start reward selection works without an evidence observer",[]{start_reward_replay::Plugin p;p.m_blackflow_start_reward_evidence_observer={};
        check(p.run()&&p.controller.clicks==2&&p.confirmed.size()==1,"optional logger changed gameplay");});
    if(argc>2&&!failed){
        int sequence=0;
        for(auto& event:contract_events){event["schema_version"]=1;event["sequence"]=++sequence;event["elapsed_ms"]=sequence;event["timestamp"]="2026-09-15T00:00:00Z";}
        std::ofstream(argv[2])<<json::array(contract_events).to_string();
    }
    if(argc>3&&!failed){
        int sequence=0;
        for(auto& event:start_reward_events){event["schema_version"]=1;event["sequence"]=++sequence;event["elapsed_ms"]=sequence;event["timestamp"]="2026-09-23T00:00:00Z";}
        std::ofstream(argv[3])<<json::array(start_reward_events).to_string();
    }
    std::cout<<passed<<" passed, "<<failed<<" failed\n";return failed?1:0;
}
