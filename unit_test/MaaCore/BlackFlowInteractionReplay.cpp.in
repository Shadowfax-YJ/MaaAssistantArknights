    for(bool complete:{true,false})test(complete?"overload handoff commits only after the real complete ordinary rescan":"overload handoff keeps the old snapshot when the real rescan is incomplete",[&]{
        inventory_replay::BlackFlowMovementTaskPlugin observer;
        whole_inventory_replay::BlackFlowMovementTaskPlugin scan;
        using whole_inventory_replay::title;
        whole_inventory_replay::configure(scan,complete?std::vector<std::vector<TextRect>>{{title("气垫底座")},{title("待收集零件")}}:
            std::vector<std::vector<TextRect>>{{title("气垫底座")},{}});
        int scans=0;
        observer.scan_override=[&](auto& target,std::string* error){
            ++scans;whole_inventory_replay::BlackFlowMovementTaskPlugin::InventoryFrame frame;
            const bool ok=scan.scan_inventory_frame(frame,error);
            if(ok){target.movement_instances=frame.movement_instances;target.lorentz_eye_found=frame.lorentz_eye_found;}
            return ok;
        };
        observer.m_port->cleanup=true;observer.observe_inventory();
        check(observer.m_session->commits==0&&observer.m_session->inventory==5&&scans==0&&Task.next=="reopen","cleanup invented a new inventory snapshot");
        observer.m_port->cleanup=false;observer.observe_inventory();
        check(scans==1,"ordinary rescan was skipped");
        if(complete)check(observer.m_session->commits==1&&observer.m_session->inventory==1&&!observer.m_session->failed,"complete rescan did not commit the refreshed inventory");
        else check(observer.m_session->commits==0&&observer.m_session->inventory==5&&observer.m_session->failed,"incomplete rescan replaced known resources");
    });
