struct AbstractTask {virtual ~AbstractTask()=default;bool m_enable=true;void set_enable(bool value){m_enable=value;}};
struct Status {inline static const std::string ProcessTaskLastTimePrefix="last:";void set_number(std::string,time_t){}};
struct ProcessTask : AbstractTask {
    enum class TimesLimitType {Pre,Post};
    enum class NodeStatus {Success,Runout,Interrupted,InternalError};
    struct HitDetail {std::shared_ptr<TaskInfo> task_ptr;std::shared_ptr<json::value> reco_detail;};
    std::unordered_map<std::string,int> m_exec_times;
    bool m_last_task_has_ui_effect=false,m_skip_current_action=false;
    int clicks=0;std::function<void()> before;
