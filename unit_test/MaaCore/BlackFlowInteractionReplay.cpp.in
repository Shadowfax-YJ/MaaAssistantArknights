        struct Pending {std::string task,button;cv::Mat image;int sampled_frames;double mean_difference;Origin origin;json::object evidence_sample;};
        struct PendingNodeEvidence {std::string action,task,phase;cv::Mat image;json::object details;Origin origin;};
        std::uint64_t sample_ordinal=0;json::object choice_reference,reward_reference;
        std::vector<Pending> pending;std::vector<PendingNodeEvidence> pending_node_evidence;
    };
    std::shared_ptr<Session> owner=std::make_shared<Session>();std::weak_ptr<Session> m_collection_popup_session=owner;
    std::unique_ptr<Context> m_task_context=std::make_unique<Context>();
    std::unique_ptr<CollectionPopupCaptureState> m_collection_popup_state=std::make_unique<CollectionPopupCaptureState>();
    bool disk_ok=true;int fail_after=-1;std::vector<json::value> events;
    bool resolve_pending_collection_popups(std::string*);bool flush_pending_collection_popups(std::string*);
    bool matches_template(const cv::Mat& image,std::string_view){return !image.empty();}
    std::optional<std::string> recognize_text(const cv::Mat&,std::string_view){return {};}
    bool record_run_event(int,const RunLogEvent& event,std::shared_ptr<cv::Mat> image,bool,std::string*){
        if(!disk_ok || (fail_after>=0 && int(events.size())>=fail_after))return false;check(image&&!image->empty(),"popup evidence has no image");
        const auto directory=event.details.get("collection_popup_directory",event.details.get("node_evidence_directory",std::string("images")));
        events.emplace_back(json::object{{"schema_version",1},{"sequence",int(events.size()+1)},
            {"timestamp","2026-10-25T00:00:00Z"},{"elapsed_ms",int(events.size()+1)},{"level","INFO"},
            {"action",event.action},{"phase",event.phase},{"outcome",event.outcome},{"task",event.task},
            {"floor",1},{"state",event.state},{"details",event.details},{"transaction_id",event.transaction_id},
            {"image",json::object{{"path",directory+"/popup-"+std::to_string(events.size()+1)+".jpg"}}}});
        return true;
    }
    bool capture_collection_popup(std::string_view,std::string*);
    bool persist_collection_popup_capture(const std::string&,std::string_view,const cv::Mat&,int,double,const std::filesystem::path&,json::object,bool,std::string*,json::object = {});
    bool persist_node_evidence_capture(std::string_view,std::string,std::string,const cv::Mat&,const std::filesystem::path&,json::object,json::object,std::string*);
};
/*POPUP_PENDING_PERSIST*/
/*POPUP_PERSIST*/
/*POPUP_CAPTURE*/
/*POPUP_RESOLVE*/
/*POPUP_FLUSH*/
}

namespace trophy_capture_replay {
constexpr std::string_view RewardTask="BlackFlow@Roguelike@GetDropTrophyRewardConfirmed";
struct BlackFlowTrophyRewardAnalyzer {
    struct Detection {std::string name,category;Rect button_rect;};
    inline static int calls=0;
    std::vector<Detection> detections;
    explicit BlackFlowTrophyRewardAnalyzer(const cv::Mat&) {++calls;detections={{"种子","自然物",{calls==1?100:500,400,80,30}},{"种荚","自然物",{900,400,80,30}}};}
    bool analyze(){return true;}const auto& get_detections()const{return detections;}
};
struct SafeRewardSelection {size_t detection_index=0;size_t priority=0;DropOptionSelection option;};
std::optional<SafeRewardSelection> resolve_safe_reward_selection(const std::vector<BlackFlowTrophyRewardAnalyzer::Detection>& detections){
    std::vector<Rect> buttons;for(const auto& d:detections)buttons.push_back(d.button_rect);
    return SafeRewardSelection{0,0,*resolve_drop_option_selection(buttons,detections[0].button_rect)};
}
struct BlackFlowTrophyRewardTaskPlugin {
    struct Parent {bool enabled=true;void set_enable(bool value){enabled=value;}} parent;
    Parent* m_task_ptr=&parent;
    struct Port {int captures=0,results=0;bool capture_ok=true,result_ok=true;Rect selected;cv::Mat frame;json::object receipt;
        bool capture_get_drop(std::string_view,Rect r,std::string*,const cv::Mat* image=nullptr){++captures;selected=r;if(image)frame=image->clone();return capture_ok||captures==1;}
        bool capture_reward_result(std::string_view,json::object d,const cv::Mat&,std::string*){++results;receipt=std::move(d);return result_ok;}
    };
    std::shared_ptr<Port> m_port=std::make_shared<Port>();
    struct Controller {int clicks=0;Rect rect;bool input_ok=true;cv::Mat get_image(){return cv::Mat(720,1280,CV_8UC3,cv::Scalar(17,0,0));}bool click(Rect r){++clicks;rect=r;return input_ok;}} controller;
    bool log_ok=true;json::object selected;cv::Mat selection_frame;
    Controller* ctrler(){return &controller;}
    std::shared_ptr<cv::Mat> get_hit_image(){return {};}
    bool record_run_event(RunLogLevel,std::string action,std::string,std::string,json::object d,std::string,std::shared_ptr<cv::Mat> image=nullptr,bool=false){if(action=="reward.trophy.select"){selected=d;if(image)selection_frame=image->clone();}return log_ok;}
    bool _run();
};
