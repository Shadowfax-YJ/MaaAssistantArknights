        p.m_port->cleanup=true;p.observe_inventory();check(!p.m_session->failed&&p.m_session->commits==0&&Task.next=="reopen","cleanup did not reopen");});
    const auto panel_fixture = std::filesystem::path(argv[1]).parent_path()/"blackflow-movement/20261025";
    const auto panel_cases = json::open(panel_fixture/"layout-pairs.json").value();
    for (const auto& pair : panel_cases.as_array()) {
        const bool stationary=pair.get("stationary",false);
        const std::vector<const char*> modes=stationary?std::vector<const char*>{"stationary", "OCR jitter"}:
            std::vector<const char*>{"settles", "OCR jitter", "keeps moving"};
        for (const auto mode : modes) {
            test(("002 actual panel " + pair.get("after_role",std::string()) + " " + mode).c_str(), [&] {
                BlackFlowMovementTaskPlugin p;
                int scans=0;
                const bool moving = std::string_view(mode)=="keeps moving";
                const bool jitter = std::string_view(mode)=="OCR jitter";
                auto before=cv::imread((panel_fixture/pair.get("before_image",std::string())).string());
                auto after=cv::imread((panel_fixture/pair.get("after_image",std::string())).string());
                check(!before.empty()&&!after.empty(),"actual movement images missing");
                p.scan_override = [&](auto& f, auto*) {
                    const bool first=scans++==0;
                    const bool old_frame=first||(moving&&scans%2);
                    for (const auto& hit : pair.at(old_frame?"before":"after").as_array()) {
                        const auto id=hit.get("movement",std::string());
                        const auto spec=std::ranges::find_if(movement_specs(),[&](const auto& s){return s.id==id;});
                        check(spec!=movement_specs().end(),"unknown movement fixture");
                        const auto& r=hit.at("rect");
                        Rect rect{r.get("x",0),r.get("y",0),r.get("width",0),r.get("height",0)};
                        if(jitter&&scans>2)rect.y+=(scans%2?3:-3);
                        const bool loaded=p.controller.loaded==spec->kind;
                        f.items.push_back({spec->kind,rect,0.99,3,loaded});
                        f.name_hits.push_back({spec->kind,rect,0.99});
                    }
                    if(p.controller.loaded==MovementKind::M11)f.loaded_movement=MovementKind::M11;
                    f.image=std::make_shared<cv::Mat>((old_frame?before:after).clone());
                    return true;
                };
                p.controller.movement_changes=false;
                p.controller.before_click=[&](const Rect& rect){
                    check(!moving&&scans>=(stationary?3:4),"clicked before the captured moving panel settled");
                    check(rect.x>=1140&&rect.y>=192,"wrong target click rectangle");
                    p.controller.loaded=MovementKind::M11;
                };
                std::string error;
                const auto result=p.select_movement(MovementKind::M11,&error);
                if(moving)check(result==BlackFlowMovementTaskPlugin::SelectionOutcome::Failed&&p.controller.clicks==0,
                                "unsettled panel allowed a click or invented success");
                else check(result==BlackFlowMovementTaskPlugin::SelectionOutcome::Selected&&p.controller.clicks==1&&
                           p.m_session->active==MovementKind::M11,"settled target did not load exactly once");
            });
        }
    }
    test("walking clipped loaded marker",[]{BlackFlowMovementTaskPlugin p;std::string error;
        check(p.select_movement(MovementKind::Walk,&error)==BlackFlowMovementTaskPlugin::SelectionOutcome::Selected,"already selected walking was rejected");
        check(p.controller.clicks==1&&p.m_session->active==MovementKind::Walk,"must accept positive map icon after one click");});
