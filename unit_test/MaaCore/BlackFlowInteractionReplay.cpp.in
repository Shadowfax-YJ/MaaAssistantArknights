    void set_skip_current_action(bool value=true){m_skip_current_action=value;}
    std::pair<int,TimesLimitType> calc_time_limit(std::shared_ptr<TaskInfo>){return {100,TimesLimitType::Pre};}
    json::value basic_info(){return json::object{};}
    void callback(AsstMsg,const json::value&){}
    bool callback_with_plugin_effect(AsstMsg msg,const json::value&){if(msg==AsstMsg::SubTaskStart&&before)before();return false;}
    bool sleep(int){return true;}bool need_exit(){return false;}bool run(){return true;}
    int calc_post_delay(std::shared_ptr<TaskInfo>){return 0;}
    Status* status(){static Status value;return &value;}
    NodeStatus run_action(const HitDetail&){++clicks;return NodeStatus::Success;}
    NodeStatus run_task(const HitDetail&);
};
