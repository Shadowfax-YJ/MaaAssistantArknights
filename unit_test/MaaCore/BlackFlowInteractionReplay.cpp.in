namespace whole_inventory_replay {
constexpr std::string_view InventorySwipeTask="forward", InventorySwipeToStartTask="back", InventoryItemsTask="items";
constexpr std::string_view InventoryResetCollapseTask="reset-collapse", InventoryScanResetExpandTask="reset-expand";
constexpr int InventoryStabilityMaximumSamples=6, InventoryStabilityProbeDelay=250;
constexpr std::string_view LoadedText="装载中";
constexpr std::string_view InventoryEmptySlotText="待收集零件";
constexpr int MaxFrameRecognitionAttempts=2, RecognitionRetryDelay=200, InventoryNewRightColumnMinimumX=760;
constexpr int InventoryLoadedMarkerMaximumVerticalGap=32;
constexpr double InventoryUnchangedFrameMaximumDifference=3.0;
struct OcrTaskInfo {};
struct { template<class T> std::shared_ptr<T> get(std::string) const{return std::make_shared<T>();} } Task;
struct OCRer {
    cv::Mat image;
    inline static std::vector<std::vector<TextRect>> pages;
    inline static bool jitter_names=false;
    inline static int reads=0;
    inline static std::vector<std::vector<TextRect>> reset_layouts;
    explicit OCRer(const cv::Mat& value):image(value){}
    void set_task_info(std::shared_ptr<OcrTaskInfo>){}
    void set_required(std::vector<std::string>){}
    std::optional<std::vector<TextRect>> analyze(){
        const int reset_sample=image.at<cv::Vec3b>(0,0)[1];
        auto names=reset_sample?reset_layouts.at(reset_sample-1):pages.at(image.at<cv::Vec3b>(0,0)[0]/20);
        if(jitter_names&&(++reads%2))for(auto& name:names){name.rect.y-=3;name.rect.height+=5;}
        return names;
    }
};
bool movement_inventory_page_visible(const cv::Mat& image){return !image.empty()&&image.at<cv::Vec3b>(0,0)[2]==0;}
std::optional<std::string_view> inventory_boundary_label(std::string_view name){
    if(name=="板藤")return "自然物";
    if(name=="洛伦茨之眼"||name=="白模狗")return "概念体";
    if(name=="待收集零件")return "空格";
    return {};
}
std::optional<std::pair<int,std::vector<MovementInventoryStarSlot>>>
recognize_movement_inventory_remaining_uses(const cv::Mat&,const Rect&,int count){return std::pair{count,std::vector<MovementInventoryStarSlot>{}};}
/*INVENTORY_REGION*/
/*INVENTORY_NAMES_UNCHANGED*/
struct Controller {
    int page=0, last_page=0;
    cv::Mat first_page_image;
    bool animate_reset_cards=false;
    int forward_swipes=0;
    bool animate_loaded=false;
    bool jitter_after_forward=false;
    int reads=0;
    bool replay_reset=false, settle_on_wait=true, reopened=false;
    int reset_index=0, reset_swipes=0, panel_state=0, collapses=0, expands=0;
    bool collapse_ok=true, expand_ok=true, reset_swipe_ok=true, stuck_expanded=false, unstable_after_reopen=false;
    bool unknown_after_collapse=false;
    cv::Mat get_image(){
        cv::Mat image(720,1280,CV_8UC3,cv::Scalar(page*20,replay_reset?reset_index+1:0,panel_state));
        if(page==0&&!first_page_image.empty()){
            image=first_page_image.clone();
            image.at<cv::Vec3b>(0,0)={0,uchar(replay_reset?reset_index+1:0),uchar(panel_state)};
        }
        if(animate_reset_cards&&forward_swipes==0)
            image(cv::Rect(500,160,200,200)).setTo(cv::Scalar::all(reset_swipes*20));
        if(animate_loaded&&page==last_page)
            image(cv::Rect(600,588,215,23)).setTo(cv::Scalar::all(((++reads/2)%2)*255));
        return image;
    }
};
struct Matcher {
    cv::Mat image;
    explicit Matcher(const cv::Mat& frame):image(frame){}
    std::string task;
    void set_task_info(std::string_view value){task=value;}
    std::optional<int> analyze(){return image.at<cv::Vec3b>(0,0)[2]==(task.ends_with("InventoryOpened")?0:1)?std::optional<int>(1):std::nullopt;}
};
struct BlackFlowMovementTaskPlugin {
    enum class InventoryAnalysisOutcome {Recognized,NoCandidate,Failed};
    struct InventoryItem {
        MovementKind movement;Rect name_rect;double name_score;int remaining_uses;
        std::vector<MovementInventoryStarSlot> star_slots;bool loaded=false;int scan_page=0,inventory_index=0;
    };
    struct InventoryBoundaryItem {std::string name,boundary_label;Rect name_rect;double name_score;int scan_page=0;};
    struct InventoryFrame {
        std::vector<RunResources::MovementInstance> movement_instances;
        std::optional<MovementKind> loaded_movement;
        std::vector<InventoryItem> items;
        std::vector<InventoryBoundaryItem> type_boundary_items;
        std::vector<TextRect> visible_names;
        std::vector<std::pair<int,std::shared_ptr<cv::Mat>>> images;
        bool scan_complete=false,lorentz_eye_found=false,has_empty_slot=false,has_clipped_item=false,page_lost=false;
    };
    Controller controller;
    bool cancelled=false;
    bool cancel_on_wait=false, lose_page_on_wait=false;
    int waits=0;
    Controller* ctrler(){return &controller;}
    bool need_exit(){return cancelled;}
    bool sleep(int){
        ++waits;
        if(cancel_on_wait)cancelled=true;
        if(lose_page_on_wait)controller.panel_state=2;
        if(controller.replay_reset){
            if(controller.settle_on_wait)controller.reset_index=0;
            else controller.reset_index=(controller.reset_index+1)%int(OCRer::reset_layouts.size());
        }
        return !cancelled;
    }
    bool run_fixed_task(std::string_view task){
        if(cancelled)return false;
        if(task==InventoryResetCollapseTask){++controller.collapses;if(!controller.collapse_ok)return false;if(!controller.stuck_expanded)controller.panel_state=controller.unknown_after_collapse?2:1;return true;}
        if(task==InventoryScanResetExpandTask){++controller.expands;if(!controller.expand_ok)return false;controller.panel_state=0;controller.replay_reset=controller.unstable_after_reopen;controller.reset_index=0;controller.reopened=true;controller.page=0;return true;}
        if(task==InventorySwipeTask){
            ++controller.forward_swipes;
            controller.replay_reset=false;
            if(controller.jitter_after_forward)OCRer::jitter_names=true;
        }
        if(task==InventorySwipeToStartTask){++controller.reset_swipes;if(!controller.reset_swipe_ok)return false;if(controller.replay_reset)controller.reset_index=std::min(controller.reset_index+1,int(OCRer::reset_layouts.size())-1);}
        controller.page=task==InventorySwipeToStartTask?std::max(0,controller.page-1):std::min(controller.last_page,controller.page+1);
        return true;
    }
    static const MovementSpec* movement_from_name(std::string_view name){
        for(const auto& spec:movement_specs())if(spec.name==name)return &spec;
        return nullptr;
    }
    static std::vector<std::string> inventory_ocr_candidates(){return {};}
    bool scan_inventory_frame(InventoryFrame&,std::string*);
    bool wait_for_inventory_stability(InventoryFrame&,cv::Mat&,std::string*);
    bool reopen_inventory_for_scan(std::string*);
    InventoryAnalysisOutcome analyze_inventory_frame(const cv::Mat&,InventoryFrame&,int,std::string*) const;
};
/*INVENTORY_SCAN*/
/*INVENTORY_STABLE*/
/*INVENTORY_REOPEN*/
/*INVENTORY_ANALYZE*/
TextRect title(std::string text,int x=900){return {{x,258,140,24},0.99,std::move(text)};}
void configure(BlackFlowMovementTaskPlugin& plugin,std::vector<std::vector<TextRect>> pages){
    OCRer::pages=std::move(pages);OCRer::jitter_names=false;OCRer::reads=0;
    plugin.controller.last_page=int(OCRer::pages.size())-1;
    plugin.controller.page=plugin.controller.last_page;
}
}

int main(int argc,char** argv) {
    int failed=0,passed=0;
    auto test=[&](const char* name,auto body){Matcher::reward_matches={};try{body();++passed;std::cout<<"PASS "<<name<<'\n';}catch(const std::exception& e){++failed;std::cerr<<"FAIL "<<name<<": "<<e.what()<<'\n';}};
    for(const auto scenario:{0,1,2,3,4,5})test(("popup save gates the actual ProcessTask close action "+std::to_string(scenario)).c_str(),[&]{
        using namespace popup_gate_replay;
        popup_gate_replay::ProcessTask process;
        popup_gate_replay::BlackFlowCollectionPopupTaskPlugin popup;popup.m_task_ptr=&process;
        int captures=0,failures=0;bool saved=false;
        popup.m_capture=[&](std::string_view,std::string* error){
            ++captures;check(process.clicks==0,"popup was clicked before capture");
            if(scenario==1||scenario==2||scenario==3||scenario==4){
                if(scenario==2)popup.controller.visible=false;
                if(scenario==3)popup.controller.empty=true;
                if(scenario==4)popup.cancelled=true;
                *error="injected save failure";return false;
            }
            if(scenario==5&&captures==1){*error="temporary save failure";return false;}
            saved=true;return true;
        };
        popup.m_failure=[&](std::string_view,std::string_view){++failures;};
        process.before=[&]{popup._run();};
        auto task=std::make_shared<TaskInfo>();task->name=popup.m_pending_task;task->action=ProcessTaskAction::ClickSelf;
        const auto status=process.run_task({task,{}});
        if(scenario==0||scenario==5)check(saved&&process.clicks==1&&failures==0,"saved popup did not resume exactly one normal close");
        else check(process.clicks==0,"popup closed without a saved image");
        if(scenario==1||scenario==3)check(failures==1&&!process.m_enable&&captures==3,"persistent save failure did not stop within its budget");
        if(scenario==2)check(failures==0&&process.m_enable&&status==popup_gate_replay::ProcessTask::NodeStatus::Success,"a vanished popup stopped normal page routing");
        if(scenario==4)check(failures==0&&captures==1,"cancellation invented a capture failure or retried");
    });
    for(const auto scenario:{0,1,2,3,4,5})test(("production popup capture persists before close "+std::to_string(scenario)).c_str(),[&]{
        popup_capture_replay::BlackFlowTaskPort port;
        if(scenario==1||scenario==2||scenario==3)port.m_task_context->stable=false;
        if(scenario==2)port.m_task_context->visible=false;
        if(scenario==3)port.m_task_context->cancelled=true;
        if(scenario==4||scenario==5)port.owner->random=true;
        if(scenario==5)port.disk_ok=false;
        std::string error;const bool result=port.capture_collection_popup("BlackFlow@Roguelike@CloseCollection",&error);
        if(scenario==2||scenario==3||scenario==5){check(!result&&port.events.empty()&&port.m_collection_popup_state->pending.empty(),"missing evidence authorized a close or left only an in-memory popup");return;}
        check(result&&port.events.size()==1,"recognized popup was not persisted before close");
        if(scenario==0)check(port.events.front().at("details").at("image_capture").get("mode",std::string())=="stable_before_click","stable popup mode changed");
        if(scenario==1)check(port.events.front().at("details").at("image_capture").get("mode",std::string())=="recognized_before_click","animated popup still claims full-frame stability");
        if(scenario==4){
            check(port.events.front().get("action",std::string())=="collection.popup.pending"&&port.m_collection_popup_state->pending.size()==1,"random-landing popup was only kept in memory");
            check(port.persist_collection_popup_capture("BlackFlow@Roguelike@CloseCollection","x",port.m_task_context->capture(),2,0,"collection-popups/floor-1/node-1",{{"kind","node"},{"floor",1},{"node",1}},true,&error,port.m_collection_popup_state->pending.front().evidence_sample),"final attributed popup failed");
            check(port.events[0].at("details").at("evidence_sample")==port.events[1].at("details").at("evidence_sample"),"deferred attribution changed the original observation");
            std::ofstream output(std::filesystem::path(argv[2]).parent_path()/"popup-contract-events.json");output<<json::array(port.events).to_string();
        }
    });
    test("popup observation retains its actual reward input reference",[&]{
        popup_capture_replay::BlackFlowTaskPort p;std::string error;
        p.m_collection_popup_state->reward_reference={{"run_revision",1},{"transaction_id",""},{"evidence_id","actual-card"}};
        check(p.capture_collection_popup("BlackFlow@Roguelike@CloseCollection",&error),"capture");
        check(p.events[0].at("details").at("evidence_sample").get("input_reference","evidence_id",std::string())=="actual-card","popup borrowed only a hash/name instead of the actual input reference");
    });
    for(bool flush:{false,true})test(flush?"flush failure preserves the unvisited evidence tail":"resolve failure preserves the unvisited evidence tail",[&]{
        popup_capture_replay::BlackFlowTaskPort port;port.owner->random=true;std::string error;
        for(int n=0;n<3;++n)check(port.capture_collection_popup("BlackFlow@Roguelike@CloseCollection",&error),"pending save");
        check(port.m_collection_popup_state->pending.size()==3,"same-name consecutive observations collapsed");
        auto first=port.m_collection_popup_state->pending[0].evidence_sample;
        auto second=port.m_collection_popup_state->pending[1].evidence_sample;
        check(first.at("evidence_id")!=second.at("evidence_id"),"image hash substituted for observation identity");
        port.owner->random=false;port.fail_after=int(port.events.size())+1;
        check(!(flush?port.flush_pending_collection_popups(&error):port.resolve_pending_collection_popups(&error)),"storage failure ignored");
        check(port.m_collection_popup_state->pending.size()==2,"write failure dropped unvisited captures");
        port.fail_after=-1;
        check(flush?port.flush_pending_collection_popups(&error):port.resolve_pending_collection_popups(&error),"retry failed");
        check(port.events.size()==6&&port.m_collection_popup_state->pending.empty(),"retry duplicated or lost final receipts");
        check(port.events[3].at("details").at("evidence_sample")==first,"final receipt lost original sample");
    });
    for(int failure:{0,1,2,3,4})test(("trophy actual confirmed card and input receipt "+std::to_string(failure)).c_str(),[&]{
        using namespace trophy_capture_replay;BlackFlowTrophyRewardAnalyzer::calls=0;
        BlackFlowTrophyRewardTaskPlugin p;
        if(failure==1)p.m_port->capture_ok=false;
        if(failure==2)p.log_ok=false;
        if(failure==3)p.m_port->result_ok=false;
        if(failure==4)p.controller.input_ok=false;
        const bool result=p._run();
        if(failure==1||failure==2){check(!result&&!p.parent.enabled&&!p.controller.clicks,"unsaved confirmed card was clicked");return;}
        check(p.controller.clicks==1&&p.controller.rect.x==500&&p.m_port->selected.x==500,"initial candidate substituted for confirmed card");
        check(!p.selection_frame.empty()&&!p.m_port->frame.empty(),"actual selected frame missing");
        check(p.m_port->receipt.get("click_dispatched",true)==(failure!=4),"failed click represented as acquisition");
        if(failure==3)check(!result&&!p.parent.enabled,"failed result persistence continued");
    });
    test("three independent event rewards retain every before and after observation",[&]{
        BlackFlowNodeEvidenceTaskPlugin p;p.controller.sequential_rewards=true;
        for(int i=0;i<4;++i)p.controller.frames.push_back(cv::Mat(720,1280,CV_8UC3,cv::Scalar::all(30+i*40)));
        for(int i=0;i<3;++i)p.run();
        check(p.controller.clicks==3&&p.m_port->results==3&&p.captures==3,"multi-item event kept only its recruitment or final click");
        for(const auto& r:p.m_port->observations)check(r.get("receipt_status",std::string())=="page_changed","independent reward page not closed by evidence");
    });
    test("reward result evidence failure prevents the next reward input",[&]{
        BlackFlowNodeEvidenceTaskPlugin p;p.m_port->result_ok=false;p.controller.frames={cv::Mat::zeros(720,1280,CV_8UC3)};p.run();
        check(!p.parent.enabled&&p.controller.clicks==1&&p.m_port->results==1,"more inputs followed unsaved reward result");
    });
    test("skipping an obsolete popup hit cannot suppress the next ordinary action",[&]{
        using namespace popup_gate_replay;
        popup_gate_replay::ProcessTask process;
        popup_gate_replay::BlackFlowCollectionPopupTaskPlugin popup;popup.m_task_ptr=&process;
        popup.controller.visible=false;
        popup.m_capture=[](std::string_view,std::string*){return false;};
        process.before=[&]{popup._run();};
        auto task=std::make_shared<TaskInfo>();task->name=popup.m_pending_task;task->action=ProcessTaskAction::ClickSelf;
        process.run_task({task,{}});check(process.clicks==0,"obsolete popup was clicked");
        process.before={};process.run_task({task,{}});
        check(process.clicks==1,"popup skip leaked into another ProcessTask hit");
    });
    auto reset_replay=[&](whole_inventory_replay::BlackFlowMovementTaskPlugin& p,const char* instance){
        using namespace whole_inventory_replay;
        const auto path=std::filesystem::path(argv[1]).parent_path()/"blackflow-inventory/20261022/runtime-layouts.json";
        const auto data=json::open(path);check(data.has_value(),"runtime reset fixture missing");
        OCRer::reset_layouts.clear();
        for(const auto& observation:data->at(instance).as_array()){
            std::vector<TextRect> names;
            for(const auto& row:observation.at("names").as_array()){
                const auto& r=row.at("rect");
                names.emplace_back(Rect{r[0].as_integer(),r[1].as_integer(),r[2].as_integer(),r[3].as_integer()},1.0,row.at("text").as_string());
            }
            OCRer::reset_layouts.push_back(std::move(names));
        }
        configure(p,{OCRer::reset_layouts.front(),{title("待收集零件")}});
        p.controller.page=0;p.controller.replay_reset=true;
    };
    test("captured duplicate engines need only one unchanged reset swipe without losing the full scan",[&]{
        using namespace whole_inventory_replay;
        whole_inventory_replay::BlackFlowMovementTaskPlugin p;
        configure(p,{
            {{{825,259,70,20},0.99,"气垫底座"},{{368,260,119,19},0.99,"一次性喷气背包"},
             {{375,421,105,19},0.99,"坎诺特的触须"},{{813,418,90,25},0.99,"试作外骨骼"},
             {{393,582,70,20},0.99,"标准引擎"},{{824,582,71,20},0.99,"标准引擎"}},
            {title("一次性喷气背包"),title("洛伦茨之眼",600)},
            {title("待收集零件")}});
        p.controller.page=0;
        p.controller.first_page_image=cv::imread((std::filesystem::path(argv[1]).parent_path()/
            "blackflow-inventory/20261024/instance003-left-edge.jpg").string());
        check(!p.controller.first_page_image.empty(),"captured duplicate inventory fixture missing");
        whole_inventory_replay::BlackFlowMovementTaskPlugin::InventoryFrame frame;std::string error;
        check(p.scan_inventory_frame(frame,&error),error.c_str());
        check(p.controller.reset_swipes==1,"stationary duplicate inventory still requires extra reset swipes");
        check(p.waits>=2&&!p.controller.reopened,"reset skipped settling or reopened unnecessarily");
        check(frame.scan_complete&&frame.lorentz_eye_found&&p.controller.forward_swipes==2,
              "early origin confirmation truncated the complete rightward scan");
        check(frame.movement_instances.size()==7,"reset lost or merged separate duplicate item instances");
    });
    test("reset from a later page stops at the first unchanged settled swipe",[]{
        using namespace whole_inventory_replay;
        whole_inventory_replay::BlackFlowMovementTaskPlugin p;
        configure(p,{{title("标准引擎"),title("标准引擎",400)},
                     {title("气垫底座")},{title("一次性喷气背包")},{title("待收集零件")}});
        p.controller.page=2;
        whole_inventory_replay::BlackFlowMovementTaskPlugin::InventoryFrame frame;std::string error;
        check(p.scan_inventory_frame(frame,&error),error.c_str());
        check(p.controller.reset_swipes==3,"moving reset stopped early or kept swiping after the origin");
        check(frame.scan_complete&&frame.movement_instances.size()==4&&p.controller.forward_swipes==3,
              "origin reset lost duplicate items or a later column");
    });
