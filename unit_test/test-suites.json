{
    "runAllOnChanges": [
        "unit_test/CMakeLists.txt",
        "unit_test/test-suites.json",
        ".github/workflows/unit-tests.yml",
        ".github/scripts/sync-optional-submodules.sh",
        "src/MaaUtils"
    ],
    "suites": [
        {
            "id": "maa-algorithm-test",
            "name": "Algorithm",
            "buildTarget": "maa-algorithm-test",
            "ctestRegex": "^algorithm::",
            "paths": ["src/MaaCore/Utils/Algorithm.hpp", "unit_test/MaaCore/AlgorithmTest.cpp"]
        },
        {
            "id": "maa-black-flow-store-trigger-test",
            "name": "Black Flow Store Trigger",
            "buildTarget": "maa-black-flow-store-trigger-test",
            "ctestRegex": "^black-flow-store-trigger::",
            "paths": [
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTrigger.hpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskPlugin.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskPlugin.h",
                "unit_test/MaaCore/BlackFlowStoreTriggerTest.cpp"
            ]
        },
        {
            "id": "maa-black-flow-store-contract-test",
            "name": "Black Flow Store Contract",
            "buildTarget": "maa-black-flow-store-contract-test",
            "ctestRegex": "^black-flow-store-contract::",
            "paths": [
                "resource/black_flow/standard_product_names.json",
                "resource/black_flow/ocr_sidecar.schema.v1.json",
                "src/MaaCore/Config/Miscellaneous/BlackFlowStoreConfig.h",
                "src/MaaCore/Config/Miscellaneous/BlackFlowStoreConfigContract.hpp",
                "src/MaaCore/Config/ResourceLoader.cpp",
                "src/MaaCore/Task/Interface/CustomTask.cpp",
                "src/MaaCore/Task/Interface/CustomTask.h",
                "src/MaaCore/Task/Miscellaneous/BlackFlowOcrSidecar.hpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowClientGuard.hpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskPlugin.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskPlugin.h",
                "src/MaaCore/Utils/EnumMapping.hpp",
                "src/MaaCore/Utils/JsonContract.hpp",
                "src/MaaCore/Utils/Sha256.hpp",
                "unit_test/MaaCore/BlackFlowStoreContractTest.cpp"
            ]
        },
        {
            "id": "maa-black-flow-store-page-test",
            "name": "Black Flow Store Page",
            "buildTarget": "maa-black-flow-store-page-test",
            "ctestRegex": "^black-flow-store-page::",
            "paths": [
                "3rdparty/include/uni_algo/**",
                "src/MaaCore/Vision/Roguelike/BlackFlowProductNameMatcher.cpp",
                "src/MaaCore/Vision/Roguelike/BlackFlowProductNameMatcher.hpp",
                "src/MaaCore/Vision/Roguelike/BlackFlowStorePageAnalyzer.cpp",
                "src/MaaCore/Vision/Roguelike/BlackFlowStorePageAnalyzer.hpp",
                "src/MaaCore/Vision/Roguelike/BlackFlowStoreImageAnalyzer.cpp",
                "src/MaaCore/Vision/Roguelike/BlackFlowStoreImageAnalyzer.h",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStorePageRepository.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStorePageRepository.hpp",
                "unit_test/MaaCore/BlackFlowStorePageTest.cpp"
            ]
        },
        {
            "id": "maa-black-flow-store-cycle-test",
            "name": "Black Flow Store Cycle",
            "buildTarget": "maa-black-flow-store-cycle-test",
            "ctestRegex": "^black-flow-store-cycle::",
            "paths": [
                "resource/tasks/MiniGame/BlackFlow.json",
                "src/MaaCore/Task/Interface/CustomTask.cpp",
                "src/MaaCore/Task/Interface/CustomTask.h",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreCycleAdapter.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreCycleAdapter.hpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreOrchestrator.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreOrchestrator.hpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStorePageRepository.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStorePageRepository.hpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreStateMachine.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreStateMachine.hpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskGraph.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskGraph.h",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskPlugin.cpp",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskPlugin.h",
                "src/MaaCore/Task/Miscellaneous/BlackFlowStoreTaskPolicy.hpp",
                "unit_test/MaaCore/BlackFlowStoreCycleTest.cpp"
            ]
        }
    ]
}
